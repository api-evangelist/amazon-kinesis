{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Kinesis Data Streams Account Monitoring API",
    "version": "2013-12-02"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Monitoring",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon Kinesis Enable enhanced shard-level monitoring",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://kinesis.{region}.amazonaws.com/#X-Amz-Target=Kinesis_20131202.EnableEnhancedMonitoring",
            "headers": [
              {
                "name": "X-Amz-Target",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Enables enhanced Kinesis data stream monitoring for shard-level metrics."
        },
        {
          "info": {
            "name": "Amazon Kinesis Disable enhanced shard-level monitoring",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://kinesis.{region}.amazonaws.com/#X-Amz-Target=Kinesis_20131202.DisableEnhancedMonitoring",
            "headers": [
              {
                "name": "X-Amz-Target",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Disables enhanced Kinesis data stream monitoring for shard-level metrics."
        }
      ]
    }
  ],
  "bundled": true
}