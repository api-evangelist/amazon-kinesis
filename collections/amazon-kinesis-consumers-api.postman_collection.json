          "name": "Amazon Kinesis Register a stream consumer for enhanced fan-out",
          "request": {
            "name": "Amazon Kinesis Register a stream consumer for enhanced fan-out",
            "description": {
              "content": "Registers a consumer with a Kinesis data stream. When you use this operation, the consumer you register can then call SubscribeToShard to receive data from the stream using enhanced fan-out, at a rate of up to 2 MiB per second for every shard you subscribe to.",
              "type": "text/plain"
            },
            "url": {
